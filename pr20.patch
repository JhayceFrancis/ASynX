Subject: [PATCH 2/2] Fix release bump workflow push failures

Co-authored-by: JhayceFrancis <162052631+JhayceFrancis@users.noreply.github.com>
---
 .github/workflows/ci-cd.yml | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/ci-cd.yml b/.github/workflows/ci-cd.yml
index da9dff0..0d278be 100644
--- a/.github/workflows/ci-cd.yml
+++ b/.github/workflows/ci-cd.yml
@@ -16,7 +16,7 @@ concurrency:
 
 jobs:
   # ==========================================
-  # JOB 1: Version Bumper & Auto-Tag
+  # JOB 1: Version Bumper
   # ==========================================
   bump-version:
     name: Bump Release Version
@@ -39,8 +39,11 @@ jobs:
 
       - name: Bump Version and Push
         run: |
-          npm version patch -m "chore(release): bump version to %s [skip ci]"
-          git push origin HEAD:${{ github.ref }} --follow-tags
+          npm version patch --no-git-tag-version
+          git add package.json package-lock.json
+          git commit -m "chore(release): bump version [skip ci]"
+          git pull --rebase origin ${{ github.ref_name }}
+          git push origin HEAD:${{ github.ref }}
 
   # ==========================================
