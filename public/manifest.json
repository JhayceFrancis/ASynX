{
  "manifest_version": 3,
  "name": "ASynX Studio",
  "short_name": "ASynX",
  "version": "2.5.90",
  "description": "ASynX - Cross-Platform Anime & Drama Sync Studio",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open ASynX"
  },
  "icons": {
    "16": "ASynX-split/ASynX_000.png",
    "48": "ASynX-split/ASynX_000.png",
    "128": "ASynX-split/ASynX_000.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.myanimelist.net/anime/*",
        "*://*.anilist.co/anime/*",
        "*://*.anidb.net/anime/*",
        "*://*.trakt.tv/shows/*",
        "*://*.trakt.tv/movies/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}