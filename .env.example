# ==========================================
# ASynX Environment Variables
# Rename this file to .env before starting
# ==========================================

# Frontend Vite Dev Server Port
VITE_PORT=4000

# Backend Express Server Port
PORT=3000

# Application Base URL 
# Change to your public domain (e.g., https://asynx.yourdomain.com) if using a reverse proxy
APP_URL=http://localhost:3000

# Fallback URL (Optional)
# Uncomment if you have set your public domain above but still require a local IP/localhost fallback for internal network access
# FALLBACK_APP_URL=http://localhost:3000

# Optional SSL Configuration for Local HTTPS
# SSL_KEY_PATH=./certs/localhost-key.pem
# SSL_CERT_PATH=./certs/localhost.pem

# DATA_DIR: Directory path where encrypted asynx_data.enc and .db_key are saved.
DATA_DIR=/app/data

# ==========================================
# Plex Media Server Integration
# ==========================================
PLEX_SERVER_URL=http://localhost:32400/web
PLEX_TOKEN=your_plex_token_here

# ==========================================
# MyAnimeList Integration
# ==========================================
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
MAL_REDIRECT_URI=http://localhost:3000/api/auth/mal/callback

# ==========================================
# Simkl Integration
# ==========================================
SIMKL_CLIENT_ID=your_simkl_client_id_here
SIMKL_CLIENT_SECRET=your_simkl_client_secret_here
SIMKL_REDIRECT_URI=http://localhost:3000/api/auth/simkl/callback

# ==========================================
# AniList Integration
# ==========================================
ANILIST_CLIENT_ID=your_anilist_client_id_here
ANILIST_CLIENT_SECRET=your_anilist_client_secret_here
ANILIST_REDIRECT_URI=http://localhost:3000/api/auth/anilist/callback


# ==========================================
# Karakeep Environment Variables
# ==========================================
# Karakeep Application Base URL (Required)
# Change this to your public domain if using a reverse proxy (e.g., https://karakeep.yourdomain.com)
NEXTAUTH_URL=http://localhost:3005

# Security Secrets
# Generate secure random strings using `openssl rand -base64 36`
# NEXTAUTH_SECRET=your_super_secret_nextauth_string_here
# MEILI_MASTER_KEY=your_super_secret_meili_master_key_here

# Version Tag
KARAKEEP_VERSION=release

# ==========================================
# AI Tagging (Optional)
# ==========================================
# Provide an OpenAI API key for automatic tagging, or leave blank to disable
OPENAI_API_KEY=

# GEMINI_API_KEY: Optional Gemini API key for AI Conflict Resolution features.
# GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM Integration (Ollama)
# Uncomment and configure below if using a local Ollama instance instead of OpenAI
# OLLAMA_BASE_URL=http://your-ollama-ip:11434
# INFERENCE_TEXT_MODEL=llama3.1
# INFERENCE_IMAGE_MODEL=llava

# ==========================================
# Authentication (JWT & OAuth)
# ==========================================
JWT_SECRET=your_super_secret_jwt_string_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here


# --- Security & Auto-Sync (GDPR Compliant) ---
JWT_SECRET=replace_this_with_a_highly_secure_random_string_for_production
IDP_CLIENT_ID=your_google_or_github_oauth_client_id_here
EXTENSION_API_KEY=your_secure_browser_extension_api_key_sync_secret
ENABLE_PII_ENCRYPTION=true
