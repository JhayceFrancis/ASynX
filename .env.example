# GEMINI_API_KEY: Optional Gemini API key for AI Conflict Resolution features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: Base URL where ASynX server is hosted.
# Used for generating webhook listeners and OAuth redirect URIs.
APP_URL=http://localhost:3000

# PORT: Express server port (default: 3000).
PORT=3000

# HOST: Network interface bind address (default: 0.0.0.0 for container accessibility).
HOST=0.0.0.0

# DATA_DIR: Directory path where encrypted asynx_data.enc and .db_key are saved.
DATA_DIR=

# SSL / TLS Configuration (Optional for native HTTPS)
SSL_KEY_PATH=
SSL_CERT_PATH=

# Remote Sync Server Authentication
REMOTE_SYNC_API_KEY=

# OAuth 2.0 Provider Credentials
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Plex/Tautulli Configuration
PLEX_SERVER_URL=
PLEX_TOKEN=
TAUTULLI_SECRET_KEY=